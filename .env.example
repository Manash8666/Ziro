# Core Runtime & Zero-GMV Platform Economics
NODE_ENV=development
ZIRO_PLATFORM_FEE_BPS=0
TENANCY_MODE=single
DEFAULT_TENANT_ID=default
POS_CONFLICT_POLICY=FORCE_SALE_WITH_ALERT

# PostgreSQL 17 + TimescaleDB + pgvector
POSTGRES_USER=ziro
POSTGRES_PASSWORD=ziro_dev_secret
POSTGRES_DB=ziro_core
DATABASE_URL=postgres://ziro:ziro_dev_secret@localhost:5432/ziro_core

# Valkey (Redis-compatible cache & job queue)
REDIS_URL=redis://localhost:6379/0

# Meilisearch
MEILISEARCH_HOST=http://localhost:7700
MEILI_MASTER_KEY=ziro_meili_master_key_change_me

# Security & Inter-Service Authentication
JWT_SECRET=ziro_secret_64_characters_minimum_random_key_string_for_development_jwt
COOKIE_SECRET=ziro_secret_64_characters_minimum_random_key_string_for_development_cookie
PAYLOAD_SECRET=ziro_payload_secret_change_me_in_production_64_chars_minimum_key
KYA_SIGNING_SECRET=ziro_kya_signing_secret_change_me_in_production_64_chars_minimum
ZIRO_INTERNAL_SECRET=ziro_internal_service_secret_change_me_in_production
ZIRO_INTERNAL_SERVICE_TOKEN=ziro-dev-service-token
CADDY_INTERNAL_SECRET=ziro_caddy_internal_secret_change_me_in_production
CRON_SECRET=ziro_cron_secret_change_me_in_production
ZIRO_ROOT_DOMAIN=ziro.build

# CORS
STORE_CORS=http://localhost:3000,http://localhost:3001
ADMIN_CORS=http://localhost:9000,http://localhost:3000,http://localhost:3001
AUTH_CORS=http://localhost:3000,http://localhost:3001,http://localhost:9000

# Dual-Hemisphere Payment Gateways & SaaS Billing (India Razorpay & Global Stripe)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_STARTER=
RAZORPAY_PLAN_GROWTH=
RAZORPAY_PLAN_SCALE=
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_SCALE=

# ONDC Beckn Seller Node
ONDC_SUBSCRIBER_ID=ziro-seller.ondc.local
ONDC_UNIQUE_KEY_ID=ziro-key-1
ONDC_PRIVATE_KEY=
ONDC_PUBLIC_KEY=
ONDC_BAP_URI=https://buyer.ondc.local/beckn
ONDC_REGISTRY_URL=https://staging.registry.ondc.org

# Service URLs & Pulse AI (@ziro/pulse)
COMMERCE_ENGINE_URL=http://localhost:9000
PULSE_AI_URL=http://localhost:8000
EMBEDDING_PROVIDER=local_hash
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
EMBEDDING_REMOTE_URL=
RTO_HIGH_RISK_THRESHOLD=0.72

# Public Web App Config (@ziro/storefront & @ziro/pos)
NEXT_PUBLIC_COMMERCE_ENGINE_URL=http://localhost:9000
NEXT_PUBLIC_PULSE_AI_URL=http://localhost:8000
NEXT_PUBLIC_STOREFRONT_URL=http://localhost:3000
NEXT_PUBLIC_POS_URL=http://localhost:3001
NEXT_PUBLIC_TENANCY_MODE=single
NEXT_PUBLIC_ZIRO_PLATFORM_FEE_BPS=0
NEXT_PUBLIC_DEFAULT_TENANT_ID=default
NEXT_PUBLIC_POS_LOCATION_ID=loc_default_01
NEXT_PUBLIC_POS_DEVICE_ID=pos_terminal_01
