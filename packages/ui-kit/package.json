{
  "name": "@ziro/ui-kit",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "./dist/tokens.css",
    "./src/tokens.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./3d": {
      "types": "./dist/3d/index.d.ts",
      "import": "./dist/3d/index.js"
    },
    "./tokens.css": "./dist/tokens.css"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"import('node:fs').then(fs=>fs.copyFileSync('src/tokens.css','dist/tokens.css'))\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@ziro/shared-types": "workspace:*",
    "lucide-react": "^1.80.0",
    "three": "^0.187.0"
  },
  "peerDependencies": {
    "react": ">=19 <19.4",
    "react-dom": ">=19 <19.4"
  },
  "devDependencies": {
    "@types/react": "^19.3.2",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.7.2",
    "vitest": "^5.1.1"
  }
}
