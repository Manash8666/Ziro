{
    # Global Caddy on-demand TLS options
    on_demand_tls {
        ask http://cloud-portal:3002/api/caddy/check-domain
        interval 2m
        burst 5
    }
}

# Dynamic Custom Domains & Multi-Tenant Hostnames
:443, :80 {
    tls {
        on_demand
    }

    # Route storefront, cloud portal, or commerce engine based on host/path
    @portal host ziro.dev cloud.ziro.dev
    handle @portal {
        reverse_proxy cloud-portal:3002
    }

    @pulse path /v1/* /api/agent/*
    handle @pulse {
        reverse_proxy pulse-ai:8000
    }

    @core path /admin/* /store/* /auth/* /medusa/*
    handle @core {
        reverse_proxy commerce-engine:9000
    }

    # Default fallback: dynamic storefront for active tenant domain
    handle {
        reverse_proxy storefront:3000
    }
}
