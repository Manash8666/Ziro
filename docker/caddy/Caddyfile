{
  email ops@ziro.build
  on_demand_tls {
    ask http://cloud-portal:3002/api/caddy/check-domain?secret={$CADDY_INTERNAL_SECRET}
    interval 2m
    burst 5
  }
}

:443 {
  tls {
    on_demand
  }

  encode zstd gzip

  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    X-Content-Type-Options "nosniff"
    X-Frame-Options "SAMEORIGIN"
    Referrer-Policy "strict-origin-when-cross-origin"
    -Server
  }

  @agent_protocols {
    path /.well-known/ucp /ucp/* /api/agent/* /v1/rto/* /v1/telemetry/*
  }
  handle @agent_protocols {
    reverse_proxy pulse-ai:8000
  }

  @commerce_api {
    path /store/* /admin/* /auth/* /webhooks/*
  }
  handle @commerce_api {
    reverse_proxy commerce-engine:9000
  }

  handle {
    reverse_proxy storefront:3000
  }
}
