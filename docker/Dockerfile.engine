FROM node:22-alpine AS base
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable && corepack prepare pnpm@12.15.0 --activate
WORKDIR /app

FROM base AS deps
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml* tsconfig.base.json turbo.json ./
COPY packages/shared-types/package.json ./packages/shared-types/
COPY packages/ui-kit/package.json ./packages/ui-kit/
COPY packages/ziro-rails/package.json ./packages/ziro-rails/
COPY apps/commerce-engine/package.json ./apps/commerce-engine/
COPY apps/storefront/package.json ./apps/storefront/
COPY apps/pos-terminal/package.json ./apps/pos-terminal/
RUN pnpm install --frozen-lockfile --filter @ziro/core...

FROM deps AS builder
COPY packages/shared-types ./packages/shared-types
COPY packages/ziro-rails ./packages/ziro-rails
COPY apps/commerce-engine ./apps/commerce-engine
RUN pnpm --filter @ziro/core... build

FROM base AS runner
ENV NODE_ENV=production
ENV PORT=9000
WORKDIR /app
RUN addgroup -S ziro && adduser -S ziro -G ziro
COPY --from=builder --chown=ziro:ziro /app ./
USER ziro
EXPOSE 9000
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD wget -qO- http://127.0.0.1:9000/health || exit 1
CMD ["pnpm", "--filter", "@ziro/core", "start"]
