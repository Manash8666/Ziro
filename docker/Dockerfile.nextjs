FROM node:22-alpine AS base
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable && corepack prepare pnpm@12.15.0 --activate
WORKDIR /app

FROM base AS deps
ARG APP_PKG=@ziro/storefront
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml* tsconfig.base.json turbo.json ./
COPY packages/shared-types/package.json ./packages/shared-types/
COPY packages/ui-kit/package.json ./packages/ui-kit/
COPY packages/ziro-rails/package.json ./packages/ziro-rails/
COPY packages/ziro-migrator/package.json ./packages/ziro-migrator/
COPY apps/commerce-engine/package.json ./apps/commerce-engine/
COPY apps/storefront/package.json ./apps/storefront/
COPY apps/pos-terminal/package.json ./apps/pos-terminal/
COPY apps/cloud-portal/package.json ./apps/cloud-portal/
RUN pnpm install --frozen-lockfile --filter . --filter ${APP_PKG}...

FROM deps AS builder
ARG APP_DIR=apps/storefront
ARG APP_PKG=@ziro/storefront
ARG NEXT_PUBLIC_COMMERCE_ENGINE_URL=http://localhost:9000
ARG NEXT_PUBLIC_PULSE_AI_URL=http://localhost:8000
ARG NEXT_PUBLIC_TENANCY_MODE=multi
ARG NEXT_PUBLIC_ZIRO_PLATFORM_FEE_BPS=0
ENV NEXT_TELEMETRY_DISABLED=1 \
    NEXT_PUBLIC_COMMERCE_ENGINE_URL=${NEXT_PUBLIC_COMMERCE_ENGINE_URL} \
    NEXT_PUBLIC_PULSE_AI_URL=${NEXT_PUBLIC_PULSE_AI_URL} \
    NEXT_PUBLIC_TENANCY_MODE=${NEXT_PUBLIC_TENANCY_MODE} \
    NEXT_PUBLIC_ZIRO_PLATFORM_FEE_BPS=${NEXT_PUBLIC_ZIRO_PLATFORM_FEE_BPS}
COPY packages ./packages
COPY ${APP_DIR} ./${APP_DIR}
RUN pnpm --filter ${APP_PKG}... build

FROM base AS runner
ARG APP_DIR=apps/storefront
ARG APP_PKG=@ziro/storefront
ARG PORT=3000
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    APP_DIR=${APP_DIR} \
    APP_PKG=${APP_PKG} \
    PORT=${PORT}
WORKDIR /app
RUN addgroup -S ziro && adduser -S ziro -G ziro
COPY --from=builder --chown=ziro:ziro /app ./
USER ziro
EXPOSE ${PORT}
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD wget -qO- http://127.0.0.1:${PORT}/ || exit 1
CMD ["sh", "-c", "pnpm --filter ${APP_PKG} start -- -H 0.0.0.0 -p ${PORT}"]
