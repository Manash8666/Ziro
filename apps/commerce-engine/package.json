{
  "name": "@ziro/core",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "db:migrate": "medusa db:migrate"
  },
  "dependencies": {
    "@medusajs/framework": "^2.23.0",
    "@medusajs/medusa": "^2.23.0",
    "@ziro/migrator": "workspace:*",
    "@ziro/rails": "workspace:*",
    "@ziro/shared-types": "workspace:*",
    "meilisearch": "^0.63.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "typescript": "^5.7.2",
    "vitest": "^5.1.1"
  }
}
